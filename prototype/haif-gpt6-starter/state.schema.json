{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ahmadnezhadhosseini64-cloud/future-ai-palang-footprint/blob/main/prototype/haif-gpt6-starter/state.schema.json",
  "title": "HAIF GPT Starter State",
  "type": "object",
  "required": ["schema", "project", "state_id", "created_at_utc", "updated_at_utc", "events", "points", "gaps", "children", "capability_boundaries"],
  "properties": {
    "schema": {"const": "haif-gpt-starter-state/0.1"},
    "project": {"type": "string", "minLength": 1},
    "state_id": {"type": "string", "minLength": 1},
    "created_at_utc": {"type": "string", "format": "date-time"},
    "updated_at_utc": {"type": "string", "format": "date-time"},
    "events": {"type": "array", "items": {"type": "object", "required": ["event_id", "kind", "created_at_utc", "parent_hash", "event_hash"]}},
    "gaps": {"type": "array", "items": {"type": "object", "required": ["gap_id", "title", "status", "evidence_class"]}},
    "children": {"type": "array"},
    "checkpoint": {"type": ["object", "null"]},
    "capability_boundaries": {"type": "object", "additionalProperties": {"type": "string"}}
  }
}
