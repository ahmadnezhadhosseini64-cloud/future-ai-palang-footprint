{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ahmadnezhadhosseini64-cloud/future-ai-palang-footprint/blob/main/prototype/haif-gpt6-starter/state.schema.json",
  "title": "HAIF GPT Starter State",
  "type": "object",
  "required": ["schema", "project", "state_id", "created_at_utc", "updated_at_utc", "events", "points", "gaps", "children", "capability_boundaries"],
  "properties": {
    "schema": {"const": "haif-gpt-starter-state/0.1"},
    "project": {"type": "string", "minLength": 1},
    "state_id": {"type": "string", "minLength": 1},
    "created_at_utc": {"type": "string", "format": "date-time"},
    "updated_at_utc": {"type": "string", "format": "date-time"},
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["event_id", "kind", "created_at_utc", "parent_hash", "event_hash"],
        "allOf": [{
          "if": {"properties": {"kind": {"const": "INTERACTION"}}, "required": ["kind"]},
          "then": {
            "required": ["anchor_id", "input_id", "output_id", "bridge_id", "bridge", "input", "output"],
            "properties": {
              "bridge_id": {"type": "string", "pattern": "^HAIF-BRIDGE-"},
              "bridge": {
                "type": "object",
                "required": ["bridge_id", "input_id", "output_id", "event_id", "parent_event_hash", "status"],
                "properties": {
                  "bridge_id": {"type": "string", "pattern": "^HAIF-BRIDGE-"},
                  "input_id": {"type": "string", "pattern": "^HAIF-IN-"},
                  "output_id": {"type": "string", "pattern": "^HAIF-OUT-"},
                  "event_id": {"type": "string", "minLength": 1},
                  "parent_event_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                  "status": {"const": "MATCHED"}
                },
                "additionalProperties": false
              }
            }
          }
        }]
      }
    },
    "gaps": {"type": "array", "items": {"type": "object", "required": ["gap_id", "title", "status", "evidence_class"]}},
    "children": {"type": "array"},
    "checkpoint": {"type": ["object", "null"]},
    "capability_boundaries": {"type": "object", "additionalProperties": {"type": "string"}}
  }
}
